# Copy this file to .env and change every value marked CHANGE.

# --- Running locally without Docker (npm run dev) ---
# Points at the dev MySQL container (docker compose -f docker-compose.dev.yml up db)
DATABASE_URL=mysql://po_user:po_password@localhost:3307/visayan_po

# --- Used by docker-compose.prod.yml ---
MYSQL_DATABASE=visayan_po
MYSQL_USER=po_user
MYSQL_PASSWORD=CHANGE-strong-db-password
MYSQL_ROOT_PASSWORD=CHANGE-strong-root-password

# Long random string that signs login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=CHANGE-me-to-a-long-random-string

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# First admin account (created on first start only).
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@visayansolar.local
ADMIN_PASSWORD=CHANGE-first-admin-password

APP_PORT=3300
