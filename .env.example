# Copy this file to .env and change every value marked CHANGE.

# --- Running locally without Docker (npm run dev) ---
# Points at the dev MySQL container (docker compose -f docker-compose.dev.yml up db)
DATABASE_URL=mysql://po_user:po_password@localhost:3307/visayan_po

# --- Used by docker-compose.prod.yml ---
MYSQL_DATABASE=visayan_po
MYSQL_USER=po_user
MYSQL_PASSWORD=CHANGE-strong-db-password
MYSQL_ROOT_PASSWORD=CHANGE-strong-root-password

# Long random string that signs login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=CHANGE-me-to-a-long-random-string

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# First admin account (created on first start only).
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@visayansolar.local
ADMIN_PASSWORD=CHANGE-first-admin-password

APP_PORT=3300

# --- Stock report email (Inventory → Stock report) — optional ---
# AI-written summary. Without a key, a standard written summary is used instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Mail account the report is sent from: inventory@visayansolar.com (Google Workspace).
# SMTP_PASS is an App Password for that account (Google Account → Security → 2-Step Verification
# → App passwords), not its normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=inventory@visayansolar.com
SMTP_PASS=CHANGE-app-password
SMTP_FROM="Visayan Solar Ventures Corporation <inventory@visayansolar.com>"

# --- Sign-in rate limiting (by IP address) — optional ---
# After LOGIN_MAX_ATTEMPTS failed sign-ins from one IP within LOGIN_LOCK_MINUTES, that IP is
# paused for LOGIN_LOCK_MINUTES.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Set to 1 when the app is behind a reverse proxy (e.g. Synology DSM reverse proxy, nginx) that adds
# the visitor's address to X-Forwarded-For, so the real visitor IP is used. Leave 0 when browsers
# connect to the app's port directly.
TRUSTED_PROXY_HOPS=0
